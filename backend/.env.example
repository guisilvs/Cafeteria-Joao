# Configurações do Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Credenciais do Banco de Dados (Turso / SQLite)
TURSO_DATABASE_URL=libsql://seu-banco-turso.turso.io
TURSO_AUTH_TOKEN=seu_token_do_turso_aqui

# Segurança e Autenticação
JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Configurações de Imagem (.webp)
WEBP_QUALITY=80
WEBP_MAX_DIMENSION=400

# Configurações de Negócio
UNIDADE_PADRAO=Shopping Beira Mar
PREVISAO_RETIRADA_MINUTOS=5
