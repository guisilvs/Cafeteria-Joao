# Configurações do Servidor
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Credenciais do Banco de Dados (PostgreSQL Local / pgAdmin)
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgres_aqui
DB_NAME=cafeteria
DB_PORT=5432

# Administrador Padrão (criado automaticamente se não existir)
ADMIN_DEFAULT_LOGIN=Admin
ADMIN_DEFAULT_PASSWORD=123456

# Segurança e Autenticação
JWT_SECRET=troque_esta_chave_em_producao
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

# Configurações de Imagem (.webp)
WEBP_QUALITY=80
WEBP_MAX_DIMENSION=400

# Configurações de Negócio
UNIDADE_PADRAO=Shopping Beira Mar
PREVISAO_RETIRADA_MINUTOS=5
